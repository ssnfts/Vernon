FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type calculated;
        value uniform 0;
    }
    outlet
    {
        type calculated;
        value uniform 0;
    }
    top
    {
        type calculated;
        value uniform 0;
    }
    side
    {
        type calculated;
        value uniform 0;
    }
    ground
    {
        type nutUSpaldingWallFunction;
        value uniform 0;
    }
    symmetry
    {
        type symmetryPlane;
    }
    "body.*"
    {
        type nutUSpaldingWallFunction;
        value uniform 0;
    }
    "wheel_.*"
    {
        type nutUSpaldingWallFunction;
        value uniform 0;
    }
}
