FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (30 0 0);

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform (30 0 0);
    }
    outlet
    {
        type inletOutlet;
        inletValue uniform (0 0 0);
        value uniform (30 0 0);
    }
    top
    {
        type slip;
    }
    side
    {
        type slip;
    }
    ground
    {
        type fixedValue;
        value uniform (30 0 0);
    }
    symmetry
    {
        type symmetryPlane;
    }
    "body.*"
    {
        type noSlip;
    }
    "wheel_.*"
    {
        type noSlip;
    }
}
