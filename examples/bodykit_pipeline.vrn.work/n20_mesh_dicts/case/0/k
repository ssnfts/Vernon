FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.0084375;

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform 0.0084375;
    }
    outlet
    {
        type inletOutlet;
        inletValue uniform 0.0084375;
        value uniform 0.0084375;
    }
    top
    {
        type zeroGradient;
    }
    side
    {
        type zeroGradient;
    }
    ground
    {
        type kqRWallFunction;
        value uniform 0.0084375;
    }
    symmetry
    {
        type symmetryPlane;
    }
    "body.*"
    {
        type kqRWallFunction;
        value uniform 0.0084375;
    }
    "wheel_.*"
    {
        type kqRWallFunction;
        value uniform 0.0084375;
    }
}
